{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "typeRoots": ["./node_modules/@types", "./src/interfaces"], 
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmitOnError": true,
    "baseUrl": "./src",
    "paths": {
      "controllers/*": ["src/controllers/*"],
      "services/*": ["src/services/*"],
      "repositories/*": ["src/repositories/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/interfaces/**/*.ts"
  ]
}
